# Copiar este archivo como .env y completar con los valores reales.
# NO subir el archivo .env al repositorio.

SECRET_KEY=poner-una-clave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=corralon_bd
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_HOST=localhost
DB_PORT=5433

# Reglas de negocio (opcionales, estos son los valores por defecto)
VENTAS_MINUTOS_PARA_CONFIRMAR=30
VENTAS_BARRIDO_MINUTOS=10

# Seguridad (opcionales)
# Origenes del frontend autorizados a consumir la API, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Horas de validez del refresh token.
REFRESH_TOKEN_HORAS=12
# HSTS en segundos. Dejar 0 en desarrollo; con HTTPS usar 31536000.
SECURE_HSTS_SECONDS=0
