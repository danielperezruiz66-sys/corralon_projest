# Copiar este archivo como .env y completar con los valores reales.
# NO subir el archivo .env al repositorio.

SECRET_KEY=poner-una-clave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origenes del frontend autorizados (separados por coma). Si el frontend
# apunta directo a Django con VITE_API_URL, agregá acá su origen.
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

DB_NAME=corralon_bd
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_HOST=localhost
DB_PORT=5433

# Reglas de negocio (opcionales, estos son los valores por defecto)
VENTAS_MINUTOS_PARA_CONFIRMAR=30
VENTAS_BARRIDO_MINUTOS=10
